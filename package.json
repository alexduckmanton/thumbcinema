{
  "name": "thumbcinema",
  "version": "3.0.0",
  "private": true,
  "description": "Online flipbook animation tool. React front end, Postgres back end.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/with-node.js vite",
    "build": "npm run typecheck && node scripts/with-node.js vite build",
    "preview": "node scripts/with-node.js vite preview",
    "test": "node scripts/with-node.js vitest run",
    "test:watch": "node scripts/with-node.js vitest",
    "test:coverage": "node scripts/with-node.js vitest run --coverage",
    "typecheck": "node scripts/with-node.js tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "node scripts/migrate.js",
    "db:import-archive": "node scripts/import-archive.js",
    "db:backfill-brotli": "node scripts/backfill-brotli.js",
    "db:stats": "node scripts/stats.js"
  },
  "dependencies": {
    "paper": "^0.12.18",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
