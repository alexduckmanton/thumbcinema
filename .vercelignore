# Vercel does not read .gitignore, so the big local-only directories have to be
# listed again here or `vercel deploy` tries to upload them. _original/ alone is
# 600+ MB of archive seed data that only the import script ever reads.
_original/
node_modules/
dist/

# Neither the build nor the function reads these.
docs/

# scripts/ and db/ stay: vite.config.ts imports scripts/lib/env.js for the dev
# server's API middleware, and excluding a file the config file mentions is a
# build failure waiting for the first time somebody changes when it's imported.

.env
.env.*
!.env.example

.DS_Store
*.log
tmp/
