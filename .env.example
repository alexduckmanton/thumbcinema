# Postgres connection string.
#
# Neon (what production uses — https://neon.tech, free tier is plenty):
#   Use the POOLED connection string, the one with "-pooler" in the host. Serverless
#   functions open and drop connections constantly and the pooler is what keeps that
#   from exhausting the database's connection limit.
#
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/thumbcinema?sslmode=require"
#
# Local Postgres, if you'd rather work offline:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thumbcinema"
#
# For local development the easiest path is a Neon *branch* of production — you get
# a real copy of the archive to work against and can reset it whenever.

DATABASE_URL=

# Port for `npm run dev`. Optional, defaults to 3000.
# PORT=3000

# Admin token. Unlocks the featured / NSFW toggles.
#
# Visit the site once at  https://…/?admin=<this value>  and it's remembered in that
# browser; the toggles then appear on gallery cards and flipbook pages. Must be at
# least 16 characters or the admin API stays switched off entirely (it 404s, so a
# deployment that forgets to set this fails closed).
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
